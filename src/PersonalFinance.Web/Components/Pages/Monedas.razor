@page "/monedas"
@rendermode InteractiveServer
@using System.Globalization
@inject MonedaServicio MonedaServicio

<PageTitle>Monedas</PageTitle>

<h1>Monedas</h1>

<EditForm Model="_nuevaMoneda" OnValidSubmit="CrearAsync">
    <InputText @bind-Value="_nuevaMoneda.Codigo" placeholder="Código" />
    <InputNumber @bind-Value="_nuevaMoneda.TipoDeCambio" placeholder="Tipo de cambio" />
    <button type="submit">Agregar</button>
</EditForm>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

<table>
    <thead>
        <tr><th>Código</th><th>Tipo de cambio</th><th>Estado</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var moneda in _monedas)
        {
            <tr>
                <td>@moneda.Codigo</td>
                <td>
                    @if (_editandoId == moneda.Id)
                    {
                        <input @bind="_cotizacionEdicion" />
                    }
                    else
                    {
                        @(moneda.TipoDeCambio?.ToString("N2", CultureInfo.InvariantCulture) ?? "—")
                    }
                </td>
                <td>@(moneda.Activa ? "activa" : "desactivada")</td>
                <td>
                    @if (moneda.EsBase)
                    {
                        <span>moneda base</span>
                    }
                    else if (_editandoId == moneda.Id)
                    {
                        <button @onclick="() => GuardarCotizacionAsync(moneda.Id)">Guardar</button>
                        <button @onclick="CancelarEdicion">Cancelar</button>
                    }
                    else
                    {
                        <button @onclick="() => EmpezarEdicion(moneda)">Editar cotización</button>
                        <button @onclick="() => EliminarAsync(moneda.Id)">Eliminar</button>
                        @if (!moneda.Activa)
                        {
                            <button @onclick="() => ReactivarAsync(moneda.Id)">Reactivar</button>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<Moneda> _monedas = [];
    private readonly NuevaMonedaModelo _nuevaMoneda = new();
    private string? _error;
    private int? _editandoId;
    private decimal _cotizacionEdicion;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync() => _monedas = await MonedaServicio.ListarAsync();

    private async Task CrearAsync()
    {
        _error = null;
        try
        {
            await MonedaServicio.CrearAsync(_nuevaMoneda.Codigo, _nuevaMoneda.TipoDeCambio);
            _nuevaMoneda.Codigo = "";
            _nuevaMoneda.TipoDeCambio = 0;
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private void EmpezarEdicion(Moneda moneda)
    {
        _editandoId = moneda.Id;
        _cotizacionEdicion = moneda.TipoDeCambio ?? 0;
    }

    private void CancelarEdicion() => _editandoId = null;

    private async Task GuardarCotizacionAsync(int id)
    {
        _error = null;
        try
        {
            await MonedaServicio.EditarCotizacionAsync(id, _cotizacionEdicion);
            _editandoId = null;
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task EliminarAsync(int id)
    {
        _error = null;
        try
        {
            await MonedaServicio.EliminarAsync(id);
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ReactivarAsync(int id)
    {
        await MonedaServicio.ReactivarAsync(id);
        await CargarAsync();
    }

    private sealed class NuevaMonedaModelo
    {
        public string Codigo { get; set; } = "";
        public decimal TipoDeCambio { get; set; }
    }
}
