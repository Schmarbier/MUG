@page "/"
@using System.Globalization
@inject ResumenMensualServicio ResumenServicio

<PageTitle>Resumen mensual</PageTitle>

<h1>Resumen mensual</h1>

@if (_resumen is not null)
{
    <section aria-label="Ingresos">
        <h2>Ingresos</h2>
        <p>Total general: <strong>@_resumen.Ingresos.TotalGeneral.ToString("N2", CultureInfo.InvariantCulture)</strong></p>
        @Tabla(_resumen.Ingresos, "pi")
    </section>

    <section aria-label="Egresos">
        <h2>Egresos</h2>
        <p>Total general: <strong>@_resumen.Egresos.TotalGeneral.ToString("N2", CultureInfo.InvariantCulture)</strong></p>
        @Tabla(_resumen.Egresos, "pe")
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "pi")]
    public int PaginaIngresos { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "pe")]
    public int PaginaEgresos { get; set; } = 1;

    private PersonalFinance.Domain.Servicios.ResumenMensual? _resumen;

    protected override async Task OnInitializedAsync()
    {
        var hoy = DateTime.Today;
        _resumen = await ResumenServicio.ObtenerResumenAsync(hoy.Year, hoy.Month, PaginaIngresos, PaginaEgresos);
    }

    private RenderFragment Tabla(BloqueResumen bloque, string parametroPagina) => @<text>
        <table>
            <thead>
                <tr><th>Categoría</th><th>Moneda</th><th>Total</th><th>Equivalente</th></tr>
            </thead>
            <tbody>
                @foreach (var fila in bloque.Filas)
                {
                    <tr>
                        <td>@fila.Categoria</td>
                        <td>@fila.CodigoMoneda</td>
                        <td>@fila.TotalEnMoneda.ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td>@(fila.EsMonedaBase ? "—" : fila.EquivalenteEnBase.ToString("N2", CultureInfo.InvariantCulture))</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (bloque.TotalPaginas > 1)
        {
            var otroParametro = parametroPagina == "pi" ? $"pe={PaginaEgresos}" : $"pi={PaginaIngresos}";
            <nav aria-label="@($"Paginación de {(parametroPagina == "pi" ? "ingresos" : "egresos")}")">
                @for (var pagina = 1; pagina <= bloque.TotalPaginas; pagina++)
                {
                    var paginaActual = pagina;
                    <a href="@($"/?{parametroPagina}={paginaActual}&{otroParametro}")"
                       aria-current="@(paginaActual == bloque.PaginaActual ? "page" : null)">
                        @paginaActual
                    </a>
                }
            </nav>
        }
    </text>;
}
