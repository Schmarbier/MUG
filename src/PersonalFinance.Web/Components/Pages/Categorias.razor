@page "/categorias"
@rendermode InteractiveServer
@inject CategoriaServicio CategoriaServicio

<PageTitle>Categorías</PageTitle>

<h1>Categorías</h1>

<EditForm Model="_nuevaCategoria" OnValidSubmit="CrearAsync">
    <InputText @bind-Value="_nuevaCategoria.Titulo" placeholder="Título" />
    <InputText @bind-Value="_nuevaCategoria.Descripcion" placeholder="Descripción" />
    <button type="submit">Crear</button>
</EditForm>

@if (_error is not null)
{
    <p class="error">@_error</p>
}

<table>
    <thead>
        <tr><th>Título</th><th>Descripción</th><th>Estado</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var categoria in _categorias)
        {
            <tr>
                @if (_editandoId == categoria.Id)
                {
                    <td><input @bind="_tituloEdicion" /></td>
                    <td><input @bind="_descripcionEdicion" /></td>
                    <td>@(categoria.Activa ? "activa" : "desactivada")</td>
                    <td>
                        <button @onclick="() => GuardarEdicionAsync(categoria.Id)">Guardar</button>
                        <button @onclick="CancelarEdicion">Cancelar</button>
                    </td>
                }
                else
                {
                    <td>@categoria.Titulo</td>
                    <td>@categoria.Descripcion</td>
                    <td>@(categoria.Activa ? "activa" : "desactivada")</td>
                    <td>
                        <button @onclick="() => EmpezarEdicion(categoria)">Editar</button>
                        <button @onclick="() => EliminarAsync(categoria.Id)">Eliminar</button>
                        @if (!categoria.Activa)
                        {
                            <button @onclick="() => ReactivarAsync(categoria.Id)">Reactivar</button>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@code {
    private IReadOnlyList<Categoria> _categorias = [];
    private readonly NuevaCategoriaModelo _nuevaCategoria = new();
    private string? _error;
    private int? _editandoId;
    private string _tituloEdicion = "";
    private string _descripcionEdicion = "";

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync() => _categorias = await CategoriaServicio.ListarAsync();

    private async Task CrearAsync()
    {
        _error = null;
        try
        {
            await CategoriaServicio.CrearAsync(_nuevaCategoria.Titulo, _nuevaCategoria.Descripcion);
            _nuevaCategoria.Titulo = "";
            _nuevaCategoria.Descripcion = "";
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private void EmpezarEdicion(Categoria categoria)
    {
        _editandoId = categoria.Id;
        _tituloEdicion = categoria.Titulo;
        _descripcionEdicion = categoria.Descripcion;
    }

    private void CancelarEdicion() => _editandoId = null;

    private async Task GuardarEdicionAsync(int id)
    {
        _error = null;
        try
        {
            await CategoriaServicio.EditarAsync(id, _tituloEdicion, _descripcionEdicion);
            _editandoId = null;
            await CargarAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task EliminarAsync(int id)
    {
        await CategoriaServicio.EliminarAsync(id);
        await CargarAsync();
    }

    private async Task ReactivarAsync(int id)
    {
        await CategoriaServicio.ReactivarAsync(id);
        await CargarAsync();
    }

    private sealed class NuevaCategoriaModelo
    {
        public string Titulo { get; set; } = "";
        public string Descripcion { get; set; } = "";
    }
}
