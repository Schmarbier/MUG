@page "/movimientos/{Id:int}/editar"
@rendermode InteractiveServer
@inject MovimientoServicio MovimientoServicio
@inject ICategoriaRepositorio CategoriaRepositorio
@inject IMonedaRepositorio MonedaRepositorio
@inject IMovimientoRepositorio MovimientoRepositorio

<PageTitle>Editar movimiento</PageTitle>

<h1>Editar movimiento</h1>

@if (_movimiento is null)
{
    <p>Movimiento no encontrado.</p>
}
else
{
    <div>
        <label for="categoria">Categoría</label>
        <select id="categoria" @bind="_categoriaId">
            @foreach (var categoria in _categorias)
            {
                <option value="@categoria.Id">@categoria.Titulo</option>
            }
        </select>
        <button @onclick="GuardarCategoriaAsync">Guardar categoría</button>
    </div>

    <div>
        <label for="tipo">Tipo</label>
        <select id="tipo" @bind="_tipo">
            <option value="@TipoMovimiento.Ingreso">Ingreso</option>
            <option value="@TipoMovimiento.Egreso">Egreso</option>
        </select>
        <button @onclick="GuardarTipoAsync">Guardar tipo</button>
    </div>

    <div>
        <label for="monto">Monto</label>
        <input id="monto" @bind="_monto" />
        <button @onclick="GuardarMontoAsync">Guardar monto</button>
    </div>

    <div>
        <label for="moneda">Moneda</label>
        <select id="moneda" @bind="_monedaId">
            @foreach (var moneda in _monedas)
            {
                <option value="@moneda.Id">@moneda.Codigo</option>
            }
        </select>
        <button @onclick="GuardarMonedaAsync">Guardar moneda</button>
    </div>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Movimiento? _movimiento;
    private IReadOnlyList<Categoria> _categorias = [];
    private IReadOnlyList<Moneda> _monedas = [];
    private int _categoriaId;
    private int _monedaId;
    private TipoMovimiento _tipo;
    private decimal _monto;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _categorias = await CategoriaRepositorio.ListarActivasAsync();
        _monedas = await MonedaRepositorio.ListarActivasAsync();
        await CargarMovimientoAsync();
    }

    private async Task CargarMovimientoAsync()
    {
        _movimiento = await MovimientoRepositorio.ObtenerPorIdAsync(Id);
        if (_movimiento is not null)
        {
            _categoriaId = _movimiento.CategoriaId;
            _monedaId = _movimiento.MonedaId;
            _tipo = _movimiento.Tipo;
            _monto = _movimiento.Monto;
        }
    }

    private Task GuardarCategoriaAsync() => EjecutarAsync(() => MovimientoServicio.EditarCategoriaAsync(Id, _categoriaId));

    private Task GuardarTipoAsync() => EjecutarAsync(() => MovimientoServicio.EditarTipoAsync(Id, _tipo));

    private Task GuardarMontoAsync() => EjecutarAsync(() => MovimientoServicio.EditarMontoAsync(Id, _monto));

    private Task GuardarMonedaAsync() => EjecutarAsync(() => MovimientoServicio.EditarMonedaAsync(Id, _monedaId));

    private async Task EjecutarAsync(Func<Task> accion)
    {
        _error = null;
        try
        {
            await accion();
            await CargarMovimientoAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
    }
}
