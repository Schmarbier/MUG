<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Composition root: el único proyecto que arma el contenedor de DI y lee IConfiguration.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Habilita `dotnet user-secrets set "TelegramBotToken" "..."`: el token no se commitea. -->
    <UserSecretsId>personalfinance-bot</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PersonalFinance.Domain\PersonalFinance.Domain.csproj" />
    <ProjectReference Include="..\PersonalFinance.Infrastructure\PersonalFinance.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
